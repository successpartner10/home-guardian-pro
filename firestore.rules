rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is the primary admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'successpartner10@gmail.com';
    }

    // Helper: Check if user has municipal/government email access
    function isMunicipalUser() {
      return request.auth != null && 
        request.auth.token.email != null && (
          request.auth.token.email == 'successpartner10@gmail.com' ||
          request.auth.token.email == 'municipal-demo@hguard.com' ||
          request.auth.token.email.matches('.*[.]gov') ||
          request.auth.token.email.matches('.*[.]mil')
        );
    }

    // Profiles: users can read/write their own profile, admin can read/write all
    match /profiles/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Devices: authenticated users can manage their own devices, admin can manage all
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Alerts: users can manage their own alerts
    match /alerts/{alertId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Signaling: any authenticated user can read/write signals for WebRTC
    match /signaling/{signalId} {
      allow read, write: if request.auth != null;
    }
    match /signaling_v2/{signalId} {
      allow read, write: if request.auth != null;
    }

    // Pairing: any authenticated user can create/read pairing codes
    match /pairing/{pairingId} {
      allow read, write: if request.auth != null;
    }

    // System config: admin can write, all authenticated users can read
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Bolo Alerts: read by all authenticated, create/delete/update by municipal/government users
    // Also allow update by any authenticated user because edge nodes update the hitCount
    match /bolo_alerts/{boloId} {
      allow read: if request.auth != null;
      allow create, delete: if isMunicipalUser();
      allow update: if request.auth != null;
    }

    // Bolo Hits: read by municipal/government users, create/write by any authenticated camera node
    match /bolo_hits/{hitId} {
      allow read: if isMunicipalUser();
      allow create: if request.auth != null;
      allow update, delete: if isMunicipalUser();
    }
  }
}
